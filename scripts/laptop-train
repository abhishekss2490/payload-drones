#!/usr/bin/env bash
# Run the cluster training pipeline on a local Linux/WSL NVIDIA GPU.
set -euo pipefail

usage() {
    cat <<'EOF'
usage: scripts/laptop-train [--dry-run] JOB_NAME PIPELINE_NAME [train args...]

Examples:
  scripts/laptop-train baseline Mjlab-PayloadTransport-RMA
  scripts/laptop-train continued Mjlab-PayloadTransport-RMA --resume <wandb-name>

Runs teacher -> distill through the same entry point as scripts/slurm-train.
New runs default to 1024 environments per phase. Set LAPTOP_NUM_ENVS or pass
--phases.teacher.env.scene.num-envs / --phases.distill.env.scene.num-envs
to override. Resume uses the saved manifest without adding defaults.

All remaining training arguments pass through unchanged, including --log-root,
phase settings, video, and GPU selection. Append --help after the pipeline name
for training options. Both phases must select the same GPU.

--dry-run prints the command without checking CUDA or starting training.
All outputs default to logs/laptop/; --log-root relocates them together.
JOB_NAME labels the console log; W&B assigns online run names.
Set WANDB_MODE=offline to save locally and sync later.
Requires the project .venv and a clean Git tree, as on the cluster.
EOF
}

DRY_RUN=false
if [[ ${1:-} == --dry-run ]]; then
    DRY_RUN=true
    shift
fi
if [[ ${1:-} == --help || ${1:-} == -h ]]; then
    usage
    exit 0
fi
if (( $# < 2 )); then
    usage >&2
    exit 2
fi
JOB_NAME=$1
PIPELINE_NAME=$2
shift 2
if [[ ! $JOB_NAME =~ ^[[:alnum:]][[:alnum:]_.-]*$ ]]; then
    echo "JOB_NAME must start with a letter/digit and contain only letters, digits, _, ., or -." >&2
    exit 2
fi

PROJECT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
PYTHON="$PROJECT/.venv/bin/python"
if [[ ! -x $PYTHON ]]; then
    echo "Missing project environment: run 'uv sync --locked' in $PROJECT first." >&2
    exit 2
fi
cd "$PROJECT"
export PYTHONUNBUFFERED=1
export GIT_PYTHON_REFRESH=quiet

has_option() {
    local option=$1 arg
    shift
    for arg in "$@"; do
        if [[ $arg == "$option" || $arg == "$option="* ]]; then
            return 0
        fi
    done
    return 1
}

# The pipeline owns help and resume. Injected phase arguments would make
# train_pipeline reject an otherwise valid --resume request.
if has_option --help "$@" || has_option -h "$@"; then
    exec "$PYTHON" -m payload_drones.train "$PIPELINE_NAME" "$@"
fi
# Keep checkpoints, console output, and W&B files under one output root.
OUTPUT_ROOT=logs/laptop
ARGS=("$@")
for ((index=0; index<${#ARGS[@]}; index++)); do
    case ${ARGS[index]} in
        --log-root)
            if (( index + 1 >= ${#ARGS[@]} )) || [[ ${ARGS[index+1]} == --* ]]; then
                echo "--log-root requires a directory." >&2
                exit 2
            fi
            OUTPUT_ROOT=${ARGS[index+1]}
            ;;
        --log-root=*) OUTPUT_ROOT=${ARGS[index]#--log-root=} ;;
    esac
done
if [[ -z $OUTPUT_ROOT ]]; then
    echo "--log-root requires a nonempty directory." >&2
    exit 2
fi
DEFAULTS=()
if ! has_option --log-root "$@"; then
    DEFAULTS+=(--log-root "$OUTPUT_ROOT")
fi
if [[ $OUTPUT_ROOT != /* ]]; then
    OUTPUT_ROOT="$PROJECT/$OUTPUT_ROOT"
fi
export WANDB_DIR="$OUTPUT_ROOT"
export WANDB_CACHE_DIR="$OUTPUT_ROOT/.cache/wandb"
export WANDB_DATA_DIR="$OUTPUT_ROOT/.wandb-data"
export WANDB_ARTIFACT_DIR="$OUTPUT_ROOT/artifacts"
# Offline W&B does not assign a display name, but the pipeline needs one.
if [[ ${WANDB_MODE:-} == offline ]]; then
    export WANDB_NAME=${WANDB_NAME:-"laptop-$JOB_NAME-$(date -u +%Y%m%dT%H%M%SZ)-$$"}
fi

if ! has_option --resume "$@"; then
    NUM_ENVS=${LAPTOP_NUM_ENVS:-1024}
    if [[ ! $NUM_ENVS =~ ^[1-9][0-9]*$ ]]; then
        echo "LAPTOP_NUM_ENVS must be a positive integer." >&2
        exit 2
    fi
    for phase in teacher distill; do
        option="--phases.$phase.env.scene.num-envs"
        if ! has_option "$option" "$@"; then
            DEFAULTS+=("$option" "$NUM_ENVS")
        fi
    done
fi
COMMAND=("$PYTHON" -m payload_drones.train "$PIPELINE_NAME" "${DEFAULTS[@]}" "$@")
if $DRY_RUN; then
    printf 'cd %q\n' "$PROJECT"
    printf '%q ' "${COMMAND[@]}"
    printf '\n'
    exit 0
fi

mkdir -p "$OUTPUT_ROOT/console" "$WANDB_CACHE_DIR" "$WANDB_DATA_DIR" "$WANDB_ARTIFACT_DIR"
CONSOLE_LOG="$OUTPUT_ROOT/console/$(date -u +%Y%m%dT%H%M%SZ)-$JOB_NAME-$$.log"
# pipefail preserves training failures through tee. Foreground execution
# delivers terminal interrupts to the training process.
{
    printf '[laptop] Output root: %s\n' "$OUTPUT_ROOT"
    printf '[laptop] Console log: %s\n' "$CONSOLE_LOG"
    printf '[laptop] Started: %s\n' "$(date -Is)"
    printf '[laptop] Command: '
    printf '%q ' "${COMMAND[@]}"
    printf '\n'
    "$PYTHON" - <<'PY'
import torch

if not torch.cuda.is_available():
    raise SystemExit("CUDA is unavailable in the project .venv. Check the NVIDIA/WSL driver and PyTorch installation.")
print(f"[laptop] PyTorch {torch.__version__}; visible CUDA devices:")
for index in range(torch.cuda.device_count()):
    free, total = torch.cuda.mem_get_info(index)
    print(f"  {index}: {torch.cuda.get_device_name(index)}, {free / 2**30:.2f}/{total / 2**30:.2f} GiB free")
PY
    "${COMMAND[@]}"
} 2>&1 | tee "$CONSOLE_LOG"
