#!/usr/bin/env bash
# Submit this project's training pipeline to Slurm via the shared launcher.
# usage: scripts/slurm-train JOB_NAME WALL_TIME PIPELINE_NAME [train args...]
set -euo pipefail
if (( $# < 3 )); then
    echo "usage: scripts/slurm-train JOB_NAME WALL_TIME PIPELINE_NAME [train args...]" >&2
    exit 2
fi
PROJECT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
exec "$PROJECT/../robotics-common/scripts/slurm-train" "$1" "$2" "$PROJECT" "${@:3}"
