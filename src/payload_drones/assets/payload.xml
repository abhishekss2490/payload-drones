<mujoco model="Payload">
    <compiler autolimits="true"/>
    <worldbody>
        <body name="payload" pos="0 0 0">
            <!-- 0.75 kg nominal; payload mass is deliberately a later DR field. -->
            <inertial mass="0.75" diaginertia="0.012 0.012 0.020" pos="0 0 0"/>
            <freejoint name="root"/>
            <geom name="payload_geom" type="box" size="0.18 0.18 0.06" rgba="0.8 0.35 0.15 1"/>
            <!-- Equilateral triangle, radius 0.15 m, on the top plane. -->
            <site name="attach_0" type="sphere" pos="0.15 0 0.06" size="0.012" rgba="1 0.2 0.2 1"/>
            <site name="attach_1" type="sphere" pos="-0.075 0.129904 0.06" size="0.012" rgba="0.2 1 0.2 1"/>
            <site name="attach_2" type="sphere" pos="-0.075 -0.129904 0.06" size="0.012" rgba="0.2 0.2 1 1"/>
        </body>
    </worldbody>
</mujoco>
